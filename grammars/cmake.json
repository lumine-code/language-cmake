{
  "name": "CMake",
  "scopeName": "source.cmake",
  "type": "tree-sitter",
  "parser": "tree-sitter-cmake",
  "injectionNames": ["cmake"],
  "fileTypes": ["cmake", "CMakeLists.txt", "cmake.in"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:uyha/tree-sitter-cmake#v0.7.4",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "cmake.wasm",
    "highlightsQuery": "cmake-highlights.scm",
    "foldsQuery": "cmake-folds.scm",
    "indentsQuery": "cmake-indents.scm",
    "tagsQuery": "cmake-tags.scm"
  }
}
